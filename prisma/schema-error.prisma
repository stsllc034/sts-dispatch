generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Driver {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  phone       String?
  email       String?
  licenseNo   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Bus {
  id          Int      @id @default(autoincrement())
  busNumber   String   @unique
  make        String?
  model       String?
  year        Int?
  vin         String?
  plateNumber String?
  seating     Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CharterParty {
  id             Int      @id @default(autoincrement())
  companyName    String
  contactName    String?
  phone          String?
  email          String?
  billingAddress String?
  city           String?
  state          String?
  zip            String?
  notes          String?
  pickupAddress String?
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Trip {
  id              Int      @id @default(autoincrement())
  tripNumber      String   @unique
  tripDate        DateTime
  charterPartyId  Int
  driverId        Int?
  busId           Int?
  destination     String?
  tripDetails     String?
  status          String   @default("Scheduled")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  charterParty CharterParty @relation(fields: [charterPartyId], references: [id])
  driver       Driver?      @relation(fields: [driverId], references: [id])
  bus          Bus?         @relation(fields: [busId], references: [id])
}
