generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Driver {
  id               Int              @id @default(autoincrement())
  firstName        String
  lastName         String
  phone            String?
  email            String?
  licenseNo        String?
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  passwordHash     String?
  sessionExpiresAt DateTime?
  sessionToken     String?
  assignments      TripAssignment[]
}

model Administrator {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  passwordHash     String
  active           Boolean   @default(true)
  sessionToken     String?   @unique
  sessionExpiresAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Bus {
  id              Int              @id @default(autoincrement())
  busNumber       String           @unique
  make            String?
  model           String?
  year            Int?
  vin             String?
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  licensePlate    String?
  seatingCapacity Int?
  status          String           @default("Available")
  assignments     TripAssignment[]
}

model CharterParty {
  id             Int      @id @default(autoincrement())
  companyName    String
  contactName    String?
  phone          String?
  email          String?
  billingAddress String?
  city           String?
  state          String?
  zip            String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  active         Boolean  @default(true)
  pickupAddress  String?
  trips          Trip[]
}

model Trip {
  id                         Int              @id @default(autoincrement())
  tripNumber                 String           @unique
  tripDate                   DateTime
  charterPartyId             Int
  pickupLocation             String
  destination                String
  passengerCount             Int?
  status                     String           @default("Draft")
  notes                      String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  arrivalTime                String?
  contactEmail               String?
  contactName                String
  contactPhone               String?
  departDestinationTime      String?
  departureTime              String?
  eventTime                  String?
  mealStop                   Boolean          @default(false)
  requestConfirmedDate       DateTime?
  requestReceivedDate        DateTime?
  returnToSchoolTime         String?
  tripDetails                String?
  tripType                   String?
  scheduledOnDutyTime        String?
  reviewComments             String?
  reviewedBy                 String?
  reviewedDate               DateTime?
  customerChangeRequest      String?
  customerChangeRequestedAt  DateTime?
  customerVerificationStatus String           @default("Pending")
  customerVerifiedAt         DateTime?
  charterParty               CharterParty     @relation(fields: [charterPartyId], references: [id])
  assignments                TripAssignment[]
}

model TripAssignment {
  id                         Int      @id @default(autoincrement())
  tripId                     Int
  driverId                   Int
  busId                      Int
  beginningOdometer          Int?
  endingOdometer             Int?
  fuelAdded                  Int?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  destinationArrivalTime     String?
  destinationDepartureTime   String?
  driverEndTime              String?
  driverStartTime            String?
  mealStop                   Boolean  @default(false)
  mealStopArrivalTime        String?
  mealStopDepartureTime      String?
  pickupDepartureTime        String?
  returnTime                 String?
  totalCustomerHours         Float?
  totalDriverHours           Float?
  contactEmail               String?
  contactName                String?
  contactPhone               String?
  studentPassengersDeparture Int?
  studentPassengersReturn    Int?
  totalPassengersDeparture   Int?
  customerSignature          String?
  bus                        Bus      @relation(fields: [busId], references: [id])
  driver                     Driver   @relation(fields: [driverId], references: [id])
  trip                       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}
