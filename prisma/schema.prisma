generator client {
  provider = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Driver {
  id          Int              @id @default(autoincrement())
  firstName   String
  lastName    String
  phone       String?
  email       String?
  passwordHash     String?
  sessionToken     String?
  sessionExpiresAt DateTime?
  licenseNo   String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  assignments TripAssignment[]
}
model Administrator {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  passwordHash     String
  active           Boolean  @default(true)
  sessionToken     String?  @unique
  sessionExpiresAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
model Bus {
  id               Int      @id @default(autoincrement())
  busNumber        String   @unique
  year             Int?
  make             String?
  model            String?
  vin              String?
  licensePlate     String?
  seatingCapacity  Int?
  status           String   @default("Available")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignments TripAssignment[]
}

model CharterParty {
  id             Int      @id @default(autoincrement())
  companyName    String
  contactName    String?
  phone          String?
  email          String?
  billingAddress String?
  city           String?
  state          String?
  zip            String?
  notes          String?
  pickupAddress  String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trips          Trip[]
}

model Trip {
  id                     Int      @id @default(autoincrement())

  // Identification
  tripNumber             String   @unique
  status                 String   @default("Draft")

  // Request Tracking
  requestReceivedDate    DateTime?
  requestConfirmedDate   DateTime?

  // Trip Dates
  tripDate               DateTime

  // Charter Party
  charterPartyId         Int
  charterParty           CharterParty @relation(fields: [charterPartyId], references: [id])

  // Contact Information (copied from selected contact)
  contactName            String
  contactPhone           String?
  contactEmail           String?

  // Trip Locations
  pickupLocation         String
  destination            String

  // Schedule
scheduledOnDutyTime      String?
arrivalTime              String?
departureTime            String?
eventTime                String?
departDestinationTime    String?
returnToSchoolTime       String?

  // Trip Details
  passengerCount         Int?
  tripDetails            String?

  // Trip Type
  tripType               String?

  // Meal Stop
  mealStop               Boolean   @default(false)
  notes         String?

// Dispatch Review
reviewedBy      String?
reviewedDate    DateTime?
reviewComments  String?

// Customer Verification
customerVerificationStatus String   @default("Pending")
customerVerifiedAt         DateTime?
customerChangeRequestedAt  DateTime?
customerChangeRequest      String?

assignments   TripAssignment[]

createdAt     DateTime @default(now())
updatedAt     DateTime @updatedAt
}

model TripAssignment {
  id                 Int      @id @default(autoincrement())
  tripId    Int
trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)

driverId  Int
driver    Driver  @relation(fields: [driverId], references: [id])

busId     Int
bus       Bus     @relation(fields: [busId], references: [id])
  beginningOdometer  Int?
  endingOdometer     Int?
  fuelAdded          Int?
  totalPassengersDeparture   Int?
  studentPassengersDeparture Int?
  studentPassengersReturn    Int?
  contactName  String?
  contactPhone String?
  contactEmail String?
  // Actual Customer Trip Times
  pickupDepartureTime     String?
  destinationArrivalTime  String?
  destinationDepartureTime String?
  returnTime              String?
  totalCustomerHours      Float?

  // Meal Stop
  mealStop                Boolean @default(false)
  mealStopArrivalTime     String?
  mealStopDepartureTime   String?

  // Driver Hours
  driverStartTime       String?
driverEndTime         String?
totalDriverHours      Float?

// Customer Signature
customerSignature     String?

createdAt             DateTime @default(now())
updatedAt             DateTime @updatedAt
}